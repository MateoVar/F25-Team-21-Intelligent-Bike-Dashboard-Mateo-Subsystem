# Copy to .env - REACT_APP_ vars end up in the public bundle, so public keys only
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Disable browser GPS fallback (gpsd only)
REACT_APP_DISABLE_BROWSER_GPS_FALLBACK=false
