# Copy to .env and fill in your own values

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Mapbox public token (pk.)
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Supabase project URL and anon key
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# gpsd on the Pi (falls back to browser GPS when false)
ENABLE_GPS=false
GPSD_HOST=localhost
GPSD_PORT=2947

# Ultrasonic sensor, distances in cm
ENABLE_ULTRASONIC=false
ULTRASONIC_CRITICAL_DISTANCE=50
ULTRASONIC_WARNING_DISTANCE=100
ULTRASONIC_SAFE_DISTANCE=200
